# Ambiente de execução: development | preview | production
APP_ENV=development

# A indexação por buscadores permanece desligada até o lançamento público.
ALLOW_INDEXING=false

# Habilita a galeria interna do Design System. Mantenha desligada em produção.
ENABLE_DESIGN_GALLERY=false

# Supabase. Localmente, `pnpm db:start` sobe o banco e `pnpm exec supabase status`
# mostra a URL da API e a chave publicável. O navegador nunca recebe esses valores.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Segredo das chaves de limitação de taxa, com pelo menos 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=

# Cloudflare Turnstile. Os valores abaixo são as chaves de teste públicas da
# Cloudflare, que sempre aprovam. Em produção, use as chaves do painel da
# Cloudflare; a aplicação recusa as de teste quando APP_ENV=production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
